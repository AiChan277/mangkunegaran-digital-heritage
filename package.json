{
  "name": "mangkunegaran-living-heritage",
  "private": true,
  "type": "module",
  "description": "Mangkunegaran — A Living Heritage · Concept. Independent multilingual concept redesign by Kelompok 7.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run check:sources && npm run check:i18n && react-router build && tsx scripts/postbuild.ts",
    "preview": "npm run build && npx wrangler dev",
    "serve": "tsx scripts/serve-static.ts 4173",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "i18n:split": "tsx scripts/split-translations.ts",
    "images": "tsx scripts/optimize-images.ts",
    "og": "tsx scripts/generate-og.ts",
    "voice-over": "tsx scripts/generate-voice-over.ts",
    "voice-over:sample": "tsx scripts/generate-voice-over.ts --sample",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:pages": "npm run build && npx wrangler pages deploy build/client --project-name mangkunegaran-living-heritage"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/noto-sans-javanese": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "@fontsource/noto-sans-lao": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@react-router/node": "^8.5.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "workerd@1.20261019.1": true
  }
}
