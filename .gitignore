# ─────────────────────────────────────────────
# Mangkunegaran — A Living Heritage · Concept
# ─────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output (React Router framework mode + Vite)
build/
dist/
.react-router/
*.tsbuildinfo
.vite/

# Generated at build time (written into build/ by scripts/postbuild.ts)
.cache/

# Voice-over samples for choosing a voice (never published)
sample-audio/

# Credentials and keys — never commit
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets.*
.npmrc
.netrc

# Image pipeline: keep originals + optimized outputs that are committed on purpose,
# ignore scratch/intermediate files
images-raw/tmp/
*.sharp-tmp

# Environment & secrets — never commit real values
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Cloudflare / Wrangler
.wrangler/
.mf/
worker-configuration.d.ts.bak

# Testing & reports
coverage/
playwright-report/
test-results/
blob-report/
/playwright/.cache/
lighthouse-reports/*.html
lighthouse-reports/*.json
!lighthouse-reports/.gitkeep
.lighthouseci/
axe-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local AI-assistant scratch (keep shared project instructions if added later)
.claude/settings.local.json
