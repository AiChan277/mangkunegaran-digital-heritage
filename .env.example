# Public base URL of the deployed site, no trailing slash.
# Leave blank until the domain is known: canonical links are then omitted.
SITE_URL=

# Studio / team credit shown in the footer, disclaimer and JSON-LD.
STUDIO_NAME=Kelompok 7
STUDIO_URL=
CONTACT_EMAIL=

# Name of the native Javanese reviewer who approved Javanese content.
# While blank, all Javanese text is labelled "awaiting native review".
JAVANESE_REVIEWER=

# open-license | own-photos | permission-granted
IMAGE_STRATEGY=open-license

# workers | pages
DEPLOY_TARGET=workers
