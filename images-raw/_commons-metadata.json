 "pendhapa-archival": {
  "title": "File:Pendopo of the Palace of the Mangkoenagoro of Surakarta WDL2898.jpg",
  "sourcePageUrl": "https://commons.wikimedia.org/wiki/File:Pendopo_of_the_Palace_of_the_Mangkoenagoro_of_Surakarta_WDL2898.jpg",
  "originalFileUrl": "https://upload.wikimedia.org/wikipedia/commons/8/89/Pendopo_of_the_Palace_of_the_Mangkoenagoro_of_Surakarta_WDL2898.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
  "downloadedFrom": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/89/Pendopo_of_the_Palace_of_the_Mangkoenagoro_of_Surakarta_WDL2898.jpg/3840px-Pendopo_of_the_Palace_of_the_Mangkoenagoro_of_Surakarta_WDL2898.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
  "width": 7728,
  "height": 4116,
  "license": "Public domain",
  "licenseUrl": "",
  "author": "Page, James",
  "description": "This photograph shows the pendopo of the palace of the Mangkunegaran dynasty in Surakarta. The pendopo, a large open-air pavilion built on columns, is a crucial element of Javanese architecture. It is open on all sides and provides shelter from sun and rain, but allows breezes to enter. Mangkunegara was established as a small principality with a hereditary ruler in the center of Surakarta in 1757, following the breakup of the area's main kingdom, Mataram, as part of the divide-and-conquer policy practiced by the Dutch in Java. The photograph was taken by the firm of Woodbury &amp; Page, which was established in 1857 by the British photographers Walter Bentley Woodbury and James Page, and specialized in portraits, ethnographic images, and photographs of life in the Dutch East Indies. The photograph is from the collections of the KITLV/Royal Netherlands Institute of Southeast Asian and Caribbean Studies in Leiden.\nCastles and palaces; Sultanates",
  "date": "1880date QS:P571,+1880-00-00T00:00:00Z/9",
  "credit": "http://dl.wdl.org/2898.png\n\nGallery: http://www.wdl.org/en/item/2898/\nhttp://media-kitlv.nl/image/c3fcf43d-7108-411e-8c58-9975e5147711",
  "attributionRequired": "false"
 },
